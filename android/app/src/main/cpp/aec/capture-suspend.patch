+
+bool RenderDelayBufferImpl::KompiReferenceGeometryValid() const {
+  const int size = static_cast<int>(blocks_.buffer.size());
+  if (size <= 0 || spectra_.buffer.size() != blocks_.buffer.size() ||
+      ffts_.buffer.size() != blocks_.buffer.size() || sub_block_size_ <= 0 ||
+      low_rate_.buffer.size() % sub_block_size_ != 0) {
+    return false;
+  }
+  const int full_lag = KompiFullRateLagBlocks();
+  const int block_lag = (blocks_.write - blocks_.read + size) % size;
+  const int fft_lag = (ffts_.read - ffts_.write + size) % size;
+  return full_lag == block_lag && full_lag == fft_lag &&
+         spectra_.read == ffts_.read && spectra_.write == ffts_.write &&
+         (blocks_.read + spectra_.read) % size == 0 &&
+         (blocks_.write + spectra_.write) % size == 0 &&
+         (low_rate_.read - low_rate_.write +
+          static_cast<int>(low_rate_.buffer.size())) % sub_block_size_ == 0;
+}
