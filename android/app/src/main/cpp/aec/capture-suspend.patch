+
+bool RenderDelayBufferImpl::KompiReferencePhaseMatches(bool inserted) const {
+  if (!reference_origin_ || !KompiReferenceGeometryValid()) {
+    return false;
+  }
+  const auto& origin = *reference_origin_;
+  const int step = inserted ? 1 : 0;
+  return BufferLatency() == origin.low_rate_lag + step &&
+         KompiFullRateLagBlocks() == origin.full_rate_lag + step &&
+         ComputeDelay() == origin.relative_delay &&
+         min_latency_blocks_ == origin.normal_minimum_latency &&
+         excess_render_detection_counter_ == origin.normal_detector_clock &&
+         capture_call_counter_ == origin.capture_clock &&
+         render_call_counter_ == origin.render_clock +
+             static_cast<int64_t>(reference_only_.ticks - origin.ticks_at_entry) + step &&
+         last_call_was_render_ == origin.last_call_was_render &&
+         num_api_calls_in_a_row_ == origin.api_calls_in_a_row &&
+         max_observed_jitter_ == origin.maximum_jitter;
