+RenderDelayBuffer::CaptureSuspensionPhase
+RenderDelayBufferImpl::KompiBeginCaptureSuspended() {
+  CaptureSuspensionPhase result;
+  result.latency_blocks = BufferLatency();
+  result.advanced_blocks = 0;
+  // Transition advances ZERO cursors. ComputeDelay alone is not a physical
+  // invariant: both the full-rate FIR history and low-rate estimator basis stay.
+  reference_only_active_ = true;
+  if (reference_only_.state == ReferenceOnlyState::kFault) {
+    return result;
+  }
+  const int latency = result.latency_blocks;
+  const int full_lag = KompiFullRateLagBlocks();
+  reference_only_.inherited_latency_blocks = latency;
+  reference_only_.inherited_full_rate_lag_blocks = full_lag;
+  reference_only_.pair_before_latency_blocks = -1;
+  reference_only_.pair_after_latency_blocks = -1;
+  reference_only_.pair_before_full_rate_lag_blocks = -1;
+  reference_only_.pair_after_full_rate_lag_blocks = -1;
+  reference_only_.canonical_minimum_latency_blocks = -1;
+  reference_only_.detector_clock = 0;
+  reference_only_.normal_detector_clock_at_entry =
+      excess_render_detection_counter_;
+  reference_only_.normal_minimum_latency_at_entry = min_latency_blocks_;
+  reference_only_.capture_clock_at_entry = capture_call_counter_;
+  reference_only_.render_clock_at_entry = render_call_counter_;
+  reference_only_.ticks_at_entry = reference_only_.ticks;
+  reference_only_.resume_latency_blocks = -1;
+  reference_only_.resume_full_rate_lag_blocks = -1;
+  reference_only_.low_rate_capacity_blocks =
+      static_cast<int>(low_rate_.buffer.size() / sub_block_size_);
+  reference_only_.maximum_full_rate_lag_blocks = static_cast<int>(MaxDelay());
+  // Keep one real Insert's space AND FIR partition headroom. Zero is a valid
+  // inherited lag. A broken phase is terminal, never a new healthy origin.
+  if (!KompiReferenceGeometryValid() || latency < 0 || full_lag < latency ||
+      latency + 1 >= reference_only_.low_rate_capacity_blocks ||
+      full_lag + 1 > reference_only_.maximum_full_rate_lag_blocks) {
+    KompiReferenceFault();
+    return result;
+  }
+  reference_origin_ = ReferenceOnlyOrigin{
+      latency, full_lag, ComputeDelay(), min_latency_blocks_,
+      excess_render_detection_counter_, capture_call_counter_,
+      last_call_was_render_, num_api_calls_in_a_row_, max_observed_jitter_,
+      render_call_counter_, reference_only_.ticks};
+  reference_only_.state = ReferenceOnlyState::kActive;
+  return result;
+}
+
+void RenderDelayBufferImpl::KompiEndCaptureSuspended() {
+  if (reference_only_active_ &&
+      reference_only_.state == ReferenceOnlyState::kActive) {
+    reference_only_.resume_latency_blocks = BufferLatency();
+    reference_only_.resume_full_rate_lag_blocks = KompiFullRateLagBlocks();
+    if (!KompiReferencePhaseMatches(false)) {
+      KompiReferenceFault();
+    } else {
+      reference_only_.state = ReferenceOnlyState::kInactive;
+    }
+  }
+  reference_only_active_ = false;
+}
+
+RenderDelayBuffer::BufferingEvent
+RenderDelayBufferImpl::KompiPrepareReferenceOnly() {
+  if (!reference_only_active_ ||
+      reference_only_.state != ReferenceOnlyState::kActive ||
+      !reference_origin_) {
+    KompiReferenceFault();
+    return BufferingEvent::kApiCallSkew;
+  }
+  if (RenderUnderrun()) {
+    KompiReferenceFault();
+    return BufferingEvent::kRenderUnderrun;
+  }
+  // Separate reference-media observation clock; the REAL capture detector's
+  // minimum/counter/jitter clock is latched untouched until actual capture.
+  // Signed subtraction supports an inherited zero without wrapping an origin.
+  const int canonical_latency =
+      1 + BufferLatency() - reference_origin_->low_rate_lag;
+  if (canonical_latency < 0) {
+    KompiReferenceFault();
+    return BufferingEvent::kApiCallSkew;
+  }
+  auto& minimum = reference_only_.canonical_minimum_latency_blocks;
+  minimum = minimum < 0 ? canonical_latency : std::min(minimum, canonical_latency);
+  if (++reference_only_.detector_clock >=
+      config_.buffering.excess_render_detection_interval_blocks) {
+    const bool excess =
+        minimum > static_cast<int>(config_.buffering.max_allowed_excess_render_blocks);
+    minimum = canonical_latency;
+    reference_only_.detector_clock = 0;
+    if (excess) {
+      last_excess_render_latency_blocks_ = BufferLatency();
+      Reset();  // Genuine reference excess remains an actual, reported reset.
+      KompiReferenceFault();
+      return BufferingEvent::kRenderOverrun;
+    }
+  }
+  if (!KompiReferencePhaseMatches(true)) {
+    KompiReferenceFault();
+    return BufferingEvent::kApiCallSkew;
+  }
+  IncrementLowRateReadIndices();
+  IncrementReadIndices();
+  reference_only_.pair_after_latency_blocks = BufferLatency();
+  reference_only_.pair_after_full_rate_lag_blocks = KompiFullRateLagBlocks();
+  ++reference_only_.ticks;
+  if (!KompiReferencePhaseMatches(false)) {
+    KompiReferenceFault();
+    return BufferingEvent::kApiCallSkew;
+  }
+  echo_remover_buffer_.SetRenderActivity(render_activity_);
+  if (render_activity_) {
+    render_activity_counter_ = 0;
+    render_activity_ = false;
+  }
+  return BufferingEvent::kNone;
+}
