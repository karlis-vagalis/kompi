+// Quantize only observation sums. Keep exact JNI double integers; invalid data
+// is explicitly unavailable, never clamped into a plausible measurement.
+bool KompiAddExactSum(double scaled_energy, uint64_t* total) {
+  constexpr uint64_t kExactLimit = (uint64_t{1} << 53) - 1;
+  if (!std::isfinite(scaled_energy) || scaled_energy < 0.0) return false;
+  const double rounded = std::round(scaled_energy);
+  if (rounded > static_cast<double>(kExactLimit)) return false;
+  const auto increment = static_cast<uint64_t>(rounded);
+  if (increment > kExactLimit - *total) return false;
+  *total += increment;
+  return true;
+}
