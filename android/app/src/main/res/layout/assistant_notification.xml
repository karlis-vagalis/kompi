<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <TextView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        android:paddingEnd="8dp"
        android:text="Running in the background"
        android:textColor="@color/assistant_notification_text"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/assistant_notification_open"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minWidth="56dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="Open session"
        android:text="Open"
        android:textColor="@color/assistant_notification_text"
        android:textSize="14sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/assistant_notification_stop"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minWidth="56dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground"
        android:text="Stop"
        android:textColor="@color/assistant_notification_text"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
